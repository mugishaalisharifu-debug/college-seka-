# Copy to backend/.env and fill in the values. Never commit the real .env.

# Postgres connection string (Supabase -> Project Settings -> Database)
DB_URL=postgresql://user:password@host:5432/postgres

# Supabase project base URL - no path suffix, the SDK appends /rest/v1 and /storage/v1
SUPABASE_URL=https://bojmkhzgmyaktwebtnbk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
SUPABASE_APPLICATIONS_BUCKET=

JWT_SECRET=

# Cloudinary (media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_SECRET_KEY=

# Brevo (transactional email)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
