<+>\"use client\";\r\n\r\nimport React, { useState } from \"react\";\r\nimport Link from \"next/link\";\r\nimport {\r\n  Camera,\r\n  FileText,\r\n  UploadCloud,\r\n  CheckCircle2,\r\n  AlertTriangle,\r\n  ArrowLeft,\r\n  Calendar,\r\n  Building,\r\n  User,\r\n  ShieldAlert,\r\n} from \"lucide-react\";\r\n\r\ninterface FormData {\r\n  firstName: string;\r\n  lastName: string;\r\n  dateOfBirth: string;\r\n  gender: string;\r\n  educationLevel: string;\r\n  previousSchool: string;\r\n  parentName: string;\r\n  parentPhone: string;\r\n  parentEmail: string;\r\n  residentialAddress: string;\r\n  relationship: string;\r\n  passportPhoto: File | null;\r\n  birthCertificate: File | null;\r\n  academicReport: File | null;\r\n  medicalForm: File | null;\r\n}\r\n\r\nexport default function ApplyPage() {\r\n  const [currentStep, setCurrentStep] = useState<number>(1);\r\n  const [validationError, setValidationError] = useState<boolean>(false);\r\n  const [isSubmitted, setIsSubmitted] = useState<boolean>(false);\r\n\r\n  const [formData, setFormData] = useState<FormData>({\r\n    firstName: \"\",\r\n    lastName: \"\",\r\n    dateOfBirth: \"\",\r\n    gender: \"\",\r\n    educationLevel: \"\",\r\n    previousSchool: \"\",\r\n    parentName: \"\",\r\n    parentPhone: \"\",\r\n    parentEmail: \"\",\r\n    residentialAddress: \"\",\r\n    relationship: \"\",\r\n    passportPhoto: null,\r\n    birthCertificate: null,\r\n    academicReport: null,\r\n    medicalForm: null,\r\n  });\r\n\r\n  const handleInputChange = (\r\n    e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>\r\n  ) => {\r\n    const { name, value } = e.target;\r\n    setFormData((prev) => ({ ...prev, [name]: value }));\r\n  };\r\n\r\n  const handleFileUpload = (\r\n    e: React.ChangeEvent<HTMLInputElement>,\r\n    field: keyof FormData\r\n  ) => {\r\n    if (e.target.files && e.target.files[0]) {\r\n      setFormData((prev) => ({ ...prev, [field]: e.target.files![0] }));\r\n      setValidationError(false);\r\n    }\r\n  };\r\n\r\n  const validateStep = (step: number) => {\r\n    if (step === 1) {\r\n      return (\r\n        formData.firstName.trim() !== \"\" &&\r\n        formData.lastName.trim() !== \"\" &&\r\n        formData.dateOfBirth !== \"\" &&\r\n        formData.gender !== \"\" &&\r\n        formData.educationLevel !== \"\"\r\n      );\r\n    }\r\n    if (step === 2) {\r\n      return (\r\n        formData.parentName.trim() !== \"\" &&\r\n        formData.parentPhone.trim() !== \"\" &&\r\n        formData.residentialAddress.trim() !== \"\" &&\r\n        formData.relationship !== \"\"\r\n      );\r\n    }\r\n    if (step === 3) {\r\n      return (\r\n        formData.passportPhoto !== null &&\r\n        formData.birthCertificate !== null &&\r\n        formData.academicReport !== null &&\r\n        formData.medicalForm !== null\r\n      );\r\n    }\r\n    return true;\r\n  };\r\n\r\n  const handleNext = () => {\r\n    if (validateStep(currentStep)) {\r\n      setValidationError(false);\r\n      setCurrentStep((prev) => Math.min(prev + 1, 4));\r\n    } else {\r\n      setValidationError(true);\r\n    }\r\n  };\r\n\r\n  const handleBack = () => {\r\n    setValidationError(false);\r\n    setCurrentStep((prev) => Math.max(prev - 1, 1));\r\n  };\r\n\r\n  const handleSubmit = (e: React.FormEvent) => {\r\n    e.preventDefault();\r\n    setIsSubmitted(true);\r\n  };\r\n\r\n  return (\r\n    <main className=\"min-h-screen pt-28 md:pt-36 pb-16 px-4 sm:px-6 lg:px-8 transition-colors\">\r\n      <div className=\"max-w-3xl mx-auto\">\r\n        \r\n        {/* STEP PROGRESS INDICATOR */}\r\n        {!isSubmitted && (\r\n          <div className=\"flex items-center justify-center gap-3 mb-10\">\r\n            {[1, 2, 3, 4].map((step) => (\r\n              <React.Fragment key={step}>\r\n                <div\r\n                  className={`w-9 h-9 rounded-full flex items-center justify-center text-sm font-bold transition-all duration-300 ${\r\n                    currentStep === step\r\n                      ? \"bg-emerald-700 text-white shadow-md scale-105\"\r\n                      : currentStep > step\r\n                      ? \"bg-emerald-800 text-white\"\r\n                      : \" text-amber-950 dark:text-zinc-400\"\r\n                  }`}\r\n                >\r\n                  {step}\r\n                </div>\r\n                {step < 4 && (\r\n                  <div\r\n                    className={`h-0.5 w-8 sm:w-12 transition-colors duration-300 ${\r\n                      currentStep > step\r\n                        ? \"bg-emerald-700\"\r\n                        : \"bg-[#e8dfd1] dark:bg-zinc-800\"\r\n                    }`}\r\n                  />\r\n                )}\r\n              </React.Fragment>\r\n            ))}\r\n          </div>\r\n        )}\r\n\r\n        {/* MAIN FORM CARD */}\r\n        <div className=\" rounded-3xl border border-amber-900/10 dark:border-zinc-800 p-6 md:p-10 shadow-sm\">\r\n          {!isSubmitted ? (\r\n            <form onSubmit={handleSubmit}>\r\n              \r\n              {/* STEP 1: STUDENT INFORMATION */}\r\n              {currentStep === 1 && (\r\n                <div className=\"space-y-6\">\r\n                  <h2 className=\"font-sans text-2xl md:text-3xl font-bold text-zinc-900 dark:text-white border-b border-amber-900/10 dark:border-zinc-800 pb-4\">\r\n                    Student Information\r\n                  </h2>\r\n\r\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-5\">\r\n                    <div>\r\n                      <label className=\"block text-sm font-semibold text-zinc-800 dark:text-zinc-200 mb-1.5\">\r\n                        First Name *\r\n                      </label>\r\n                      <input\r\n                        type=\"text\"\r\n                        name=\"firstName\"\r\n                        value={formData.firstName}\r\n                        onChange={handleInputChange}\r\n                        required\r\n                        placeholder=\"Enter first name\"\r\n                        className=\"w-full px-4 py-3 rounded-xl border border-amber-900/15 dark:border-zinc-700  text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-emerald-700 transition-all text-sm\"\r\n                      />\r\n                    </div>\r\n\r\n                    <div>\r\n                      <label className=\"block text-sm font-semibold text-zinc-800 dark:text-zinc-200 mb-1.5\">\r\n                        Last Name *\r\n                      </label>\r\n                      <input\r\n                        type=\"text\"\r\n                        name=\"lastName\"\r\n                        value={formData.lastName}\r\n                        onChange={handleInputChange}\r\n                        required\r\n                        placeholder=\"Enter last name\"\r\n                        className=\"w-full px-4 py-3 rounded-xl border border-amber-900/15 dark:border-zinc-700  text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-emerald-700 transition-all text-sm\"\r\n                      />\r\n                    </div>\r\n                  </div>\r\n\r\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-5\">\r\n                    <div>\r\n                      <label className=\"block text-sm font-semibold text-zinc-800 dark:text-zinc-200 mb-1.5\">\r\n                        Date of Birth *\r\n                      </label>\r\n                      <div className=\"relative\">\r\n                        <input\r\n                          type=\"date\"\r\n                          name=\"dateOfBirth\"\r\n                          value={formData.dateOfBirth}\r\n                          onChange={handleInputChange}\r\n                          required\r\n                          className=\"w-full px-4 py-3 rounded-xl border border-amber-900/15 dark:border-zinc-700 text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-emerald-700 transition-all text-sm\"\r\n                        />\r\n                      </div>\r\n                    </div>\r\n\r\n                    <div>\r\n                      <label className=\"block text-sm font-semibold text-zinc-800 dark:text-zinc-200 mb-1.5\">\r\n                        Gender *\r\n                      </label>\r\n                      <select\r\n                        name=\"gender\"\r\n                        value={formData.gender}\r\n                        onChange={handleInputChange}\r\n                        required\r\n                        className=\"w-full px-4 py-3 rounded-xl border border-amber-900/15 dark:border-zinc-700  text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-emerald-700 transition-all text-sm\"\r\n                      >\r\n                        <option value=\"\">Select Gender</option>\r\n                        <option value=\"Male\">Male</option>\r\n                        <option value=\"Female\">Female</option>\r\n                      </select>\r\n                    </div>\r\n                  </div>\r\n\r\n                  <div>\r\n                    <label className=\"block text-sm font-semibold text-zinc-800 dark:text-zinc-200 mb-1.5\">\r\n                      Education Level *\r\n                    </label>\r\n                    <select\r\n                      name=\"educationLevel\"\r\n                      value={formData.educationLevel}\r\n                      onChange={handleInputChange}\r\n                      required\r\n                      className=\"w-full px-4 py-3 rounded-xl border border-amber-900/15 dark:border-zinc-700  text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-emerald-700 transition-all text-sm\"\r\n                    >\r\n                      <option value=\"\">Select Education Level</option>\r\n                      <option value=\"Nursery\">Nursery School</option>\r\n                      <option value=\"Primary\">Primary School</option>\r\n                      <option value=\"Lower Secondary\">Lower Secondary (S1 - S3)</option>\r\n                      <option value=\"TVET\">TVET Program (Technical & Vocational)</option>\r\n                    </select>\r\n                  </div>\r\n\r\n                  <div>\r\n                    <label className=\"block text-sm font-semibold text-zinc-800 dark:text-zinc-200 mb-1.5\">\r\n                      Previous School (if any)\r\n                    </label>\r\n                    <input\r\n                      type=\"text\"\r\n                      name=\"previousSchool\"\r\n                      value={formData.previousSchool}\r\n                      onChange={handleInputChange}\r\n                      placeholder=\"Enter previous school name\"\r\n                      className=\"w-full px-4 py-3 rounded-xl border border-amber-900/15 dark:border-zinc-700  text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-emerald-700 transition-all text-sm\"\r\n                    />\r\n                  </div>\r\n\r\n                  {validationError && (\r\n                    <div className=\"p-4 rounded-xl bg-amber-100/80 dark:bg-amber-950/50 border border-amber-300 dark:border-amber-800 text-amber-900 dark:text-amber-200 text-sm flex items-center gap-2\">\r\n                      <AlertTriangle className=\"w-5 h-5 shrink-0 text-amber-700 dark:text-amber-400\" />\r\n                      <span>Please fill in all required fields marked with an asterisk (*).</span>\r\n                    </div>\r\n                  )}\r\n\r\n                  <div className=\"flex justify-end pt-4\">\r\n                    <button\r\n                      type=\"button\"\r\n                      onClick={handleNext}\r\n                      className=\"px-6 py-3 rounded-xl bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-sm transition-all shadow-md\"\r\n                    >\r\n                      Next: Parent Info\r\n                    </button>\r\n                  </div>\r\n                </div>\r\n              )}\r\n\r\n              {/* STEP 2: PARENT / GUARDIAN INFORMATION */}\r\n              {currentStep === 2 && (\r\n                <div className=\"space-y-6\">\r\n                  <h2 className=\"font-sans text-2xl md:text-3xl font-bold text-zinc-900 dark:text-white border-b border-amber-900/10 dark:border-zinc-800 pb-4\">\r\n                    Parent / Guardian Information\r\n                  </h2>\r\n\r\n                  <div>\r\n                    <label className=\"block text-sm font-semibold text-zinc-800 dark:text-zinc-200 mb-1.5\">\r\n                      Full Name *\r\n                    </label>\r\n                    <input\r\n                      type=\"text\"\r\n                      name=\"parentName\"\r\n                      value={formData.parentName}\r\n                      onChange={handleInputChange}\r\n                      required\r\n                      placeholder=\"Enter parent or guardian full name\"\r\n                      className=\"w-full px-4 py-3 rounded-xl border border-amber-900/15 dark:border-zinc-700  text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-emerald-700 transition-all text-sm\"\r\n                    />\r\n                  </div>\r\n\r\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-5\">\r\n                    <div>\r\n                      <label className=\"block text-sm font-semibold text-zinc-800 dark:text-zinc-200 mb-1.5\">\r\n                        Phone Number *\r\n                      </label>\r\n                      <input\r\n                        type=\"tel\"\r\n                        name=\"parentPhone\"\r\n                        value={formData.parentPhone}\r\n                        onChange={handleInputChange}\r\n                        required\r\n                        placeholder=\"+250 788 000 000\"\r\n                        className=\"w-full px-4 py-3 rounded-xl border border-amber-900/15 dark:border-zinc-700 text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-emerald-700 transition-all text-sm\"\r\n                      />\r\n                    </div>\r\n\r\n                    <div>\r\n                      <label className=\"block text-sm font-semibold text-zinc-800 dark:text-zinc-200 mb-1.5\">\r\n                        Email Address\r\n                      </label>\r\n                      <input\r\n                        type=\"email\"\r\n                        name=\"parentEmail\"\r\n                        value={formData.parentEmail}\r\n                        onChange={handleInputChange}\r\n                        placeholder=\"parent@example.com\"\r\n                        className=\"w-full px-4 py-3 rounded-xl border border-amber-900/15 dark:border-zinc-700 text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-emerald-700 transition-all text-sm\"\r\n                      />\r\n                    </div>\r\n                  </div>\r\n\r\n                  <div>\r\n                    <label className=\"block text-sm font-semibold text-zinc-800 dark:text-zinc-200 mb-1.5\">\r\n                      Residential Address *\r\n                    </label>\r\n                    <textarea\r\n                      name=\"residentialAddress\"\r\n                      value={formData.residentialAddress}\r\n                      onChange={handleInputChange}\r\n                      rows={3}\r\n                      required\r\n                      placeholder=\"District, Sector, Cell, Village\"\r\n                      className=\"w-full px-4 py-3 rounded-xl border border-amber-900/15 dark:border-zinc-700  text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-emerald-700 transition-all text-sm\"\r\n                    />\r\n                  </div>\r\n\r\n                  <div>\r\n                    <label className=\"block text-sm font-semibold text-zinc-800 dark:text-zinc-200 mb-1.5\">\r\n                      Relationship to Student *\r\n                    </label>\r\n                    <select\r\n                      name=\"relationship\"\r\n                      value={formData.relationship}\r\n                      onChange={handleInputChange}\r\n                      required\r\n                      className=\"w-full px-4 py-3 rounded-xl border border-amber-900/15 dark:border-zinc-700  text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-emerald-700 transition-all text-sm\"\r\n                    >\r\n                      <option value=\"\">Select Relationship</option>\r\n                      <option value=\"Father\">Father</option>\r\n                      <option value=\"Mother\">Mother</option>\r\n                      <option value=\"Guardian\">Guardian</option>\r\n                      <option value=\"Other\">Other Relative</option>\r\n                    </select>\r\n                  </div>\r\n\r\n                  {validationError && (\r\n                    <div className=\"p-4 rounded-xl bg-amber-100/80 dark:bg-amber-950/50 border border-amber-300 dark:border-amber-800 text-amber-900 dark:text-amber-200 text-sm flex items-center gap-2\">\r\n                      <AlertTriangle className=\"w-5 h-5 shrink-0 text-amber-700 dark:text-amber-400\" />\r\n                      <span>Please complete all required parent contact details.</span>\r\n                    </div>\r\n                  )}\r\n\r\n                  <div className=\"flex items-center justify-between pt-4\">\r\n                    <button\r\n                      type=\"button\"\r\n                      onClick={handleBack}\r\n                      className=\"px-5 py-2.5 rounded-xl border border-amber-900/20 dark:border-zinc-700 text-zinc-800 dark:text-zinc-200 hover:bg-[#f3edd1] dark:hover:bg-zinc-800 font-semibold text-sm transition-all\"\r\n                    >\r\n                      Back\r\n                    </button>\r\n                    <button\r\n                      type=\"button\"\r\n                      onClick={handleNext}\r\n                      className=\"px-6 py-3 rounded-xl bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-sm transition-all shadow-md\"\r\n                    >\r\n                      Next: Documents\r\n                    </button>\r\n                  </div>\r\n                </div>\r\n              )}\r\n\r\n              {/* STEP 3: REQUIRED DOCUMENTS */}\r\n              {currentStep === 3 && (\r\n                <div className=\"space-y-6\">\r\n                  <div>\r\n                    <h2 className=\"font-sans text-2xl md:text-3xl font-bold text-zinc-900 dark:text-white mb-1\">\r\n                      Required Documents\r\n                    </h2>\r\n                    <p className=\"text-sm text-zinc-600 dark:text-zinc-400\">\r\n                      Please upload the following documents to complete your application. Accepted formats: JPG, PNG, PDF.\r\n                    </p>\r\n                  </div>\r\n\r\n                  {/* PASSPORT PHOTO */}\r\n                  <div className=\"p-5 rounded-2xl  border border-amber-900/10 dark:border-zinc-700 space-y-3\">\r\n                    <div className=\"flex items-center justify-between\">\r\n                      <div className=\"flex items-center gap-3\">\r\n                        <div className=\"w-10 h-10 rounded-xl bg-emerald-100 dark:bg-emerald-950/80 text-emerald-800 dark:text-emerald-300 flex items-center justify-center\">\r\n                          <Camera className=\"w-5 h-5\" />\r\n                        </div>\r\n                        <div>\r\n                          <h4 className=\"font-bold text-sm text-zinc-900 dark:text-white\">\r\n                            Passport Photograph *\r\n                          </h4>\r\n                          <p className=\"text-xs text-zinc-500 dark:text-zinc-400\">\r\n                            Recent passport-sized photo with white background\r\n                          </p>\r\n                        </div>\r\n                      </div>\r\n                      {formData.passportPhoto ? (\r\n                        <span className=\"px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 flex items-center gap-1\">\r\n                          <CheckCircle2 className=\"w-3.5 h-3.5\" /> Uploaded\r\n                        </span>\r\n                      ) : (\r\n                        <span className=\"px-2.5 py-1 rounded-full text-xs font-semibold bg-rose-100 text-rose-800 dark:bg-rose-950/80 dark:text-rose-300\">\r\n                          × Required\r\n                        </span>\r\n                      )}\r\n                    </div>\r\n                    <label className=\"border-2 border-dashed border-amber-900/20 dark:border-zinc-700 rounded-xl p-4 flex items-center justify-center gap-2 cursor-pointer hover:bg-amber-100/30 dark:hover:bg-zinc-700/30 transition-all text-sm font-semibold text-zinc-700 dark:text-zinc-300\">\r\n                      <UploadCloud className=\"w-4 h-4 text-emerald-700 dark:text-emerald-400\" />\r\n                      <span>{formData.passportPhoto ? formData.passportPhoto.name : \"Click to upload passport photo\"}</span>\r\n                      <input\r\n                        type=\"file\"\r\n                        accept=\"image/*,.pdf\"\r\n                        className=\"hidden\"\r\n                        onChange={(e) => handleFileUpload(e, \"passportPhoto\")}\r\n                      />\r\n                    </label>\r\n                  </div>\r\n\r\n                  {/* BIRTH CERTIFICATE */}\r\n                  <div className=\"p-5 rounded-2xl border border-amber-900/10 dark:border-zinc-700 space-y-3\">\r\n                    <div className=\"flex items-center justify-between\">\r\n                      <div className=\"flex items-center gap-3\">\r\n                        <div className=\"w-10 h-10 rounded-xl bg-amber-100 dark:bg-amber-950/80 text-amber-900 dark:text-amber-300 flex items-center justify-center\">\r\n                          <FileText className=\"w-5 h-5\" />\r\n                        </div>\r\n                        <div>\r\n                          <h4 className=\"font-bold text-sm text-zinc-900 dark:text-white\">\r\n                            Birth Certificate *\r\n                          </h4>\r\n                          <p className=\"text-xs text-zinc-500 dark:text-zinc-400\">\r\n                            Official birth certificate or affidavit\r\n                          </p>\r\n                        </div>\r\n                      </div>\r\n                      {formData.birthCertificate ? (\r\n                        <span className=\"px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 flex items-center gap-1\">\r\n                          <CheckCircle2 className=\"w-3.5 h-3.5\" /> Uploaded\r\n                        </span>\r\n                      ) : (\r\n                        <span className=\"px-2.5 py-1 rounded-full text-xs font-semibold bg-rose-100 text-rose-800 dark:bg-rose-950/80 dark:text-rose-300\">\r\n                          × Required\r\n                        </span>\r\n                      )}\r\n                    </div>\r\n                    <label className=\"border-2 border-dashed border-amber-900/20 dark:border-zinc-700 rounded-xl p-4 flex items-center justify-center gap-2 cursor-pointer hover:bg-amber-100/30 dark:hover:bg-zinc-700/30 transition-all text-sm font-semibold text-zinc-700 dark:text-zinc-300\">\r\n                      <UploadCloud className=\"w-4 h-4 text-emerald-700 dark:text-emerald-400\" />\r\n                      <span>{formData.birthCertificate ? formData.birthCertificate.name : \"Click to upload birth certificate\"}</span>\r\n                      <input\r\n                        type=\"file\"\r\n                        accept=\"image/*,.pdf\"\r\n                        className=\"hidden\"\r\n                        onChange={(e) => handleFileUpload(e, \"birthCertificate\")}\r\n                      />\r\n                    </label>\r\n                  </div>\r\n\r\n                  {/* PREVIOUS ACADEMIC REPORT */}\r\n                  <div className=\"p-5 rounded-2xl  border border-amber-900/10 dark:border-zinc-700 space-y-3\">\r\n                    <div className=\"flex items-center justify-between\">\r\n                      <div className=\"flex items-center gap-3\">\r\n                        <div className=\"w-10 h-10 rounded-xl bg-amber-100 dark:bg-amber-950/80 text-amber-900 dark:text-amber-300 flex items-center justify-center\">\r\n                          <FileText className=\"w-5 h-5\" />\r\n                        </div>\r\n                        <div>\r\n                          <h4 className=\"font-bold text-sm text-zinc-900 dark:text-white\">\r\n                            Previous Academic Report *\r\n                          </h4>\r\n                          <p className=\"text-xs text-zinc-500 dark:text-zinc-400\">\r\n                            Most recent school report or transcript\r\n                          </p>\r\n                        </div>\r\n                      </div>\r\n                      {formData.academicReport ? (\r\n                        <span className=\"px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 flex items-center gap-1\">\r\n                          <CheckCircle2 className=\"w-3.5 h-3.5\" /> Uploaded\r\n                        </span>\r\n                      ) : (\r\n                        <span className=\"px-2.5 py-1 rounded-full text-xs font-semibold bg-rose-100 text-rose-800 dark:bg-rose-950/80 dark:text-rose-300\">\r\n                          × Required\r\n                        </span>\r\n                      )}\r\n                    </div>\r\n                    <label className=\"border-2 border-dashed border-amber-900/20 dark:border-zinc-700 rounded-xl p-4 flex items-center justify-center gap-2 cursor-pointer hover:bg-amber-100/30 dark:hover:bg-zinc-700/30 transition-all text-sm font-semibold text-zinc-700 dark:text-zinc-300\">\r\n                      <UploadCloud className=\"w-4 h-4 text-emerald-700 dark:text-emerald-400\" />\r\n                      <span>{formData.academicReport ? formData.academicReport.name : \"Click to upload previous report\"}</span>\r\n                      <input\r\n                        type=\"file\"\r\n                        accept=\"image/*,.pdf\"\r\n                        className=\"hidden\"\r\n                        onChange={(e) => handleFileUpload(e, \"academicReport\")}\r\n                      />\r\n                    </label>\r\n                  </div>\r\n\r\n                  {/* MEDICAL FORM */}\r\n                  <div className=\"p-5 rounded-2xl border border-amber-900/10 dark:border-zinc-700 space-y-3\">\r\n                    <div className=\"flex items-center justify-between\">\r\n                      <div className=\"flex items-center gap-3\">\r\n                        <div className=\"w-10 h-10 rounded-xl bg-emerald-100 dark:bg-emerald-950/80 text-emerald-800 dark:text-emerald-300 flex items-center justify-center\">\r\n                          <FileText className=\"w-5 h-5\" />\r\n                        </div>\r\n                        <div>\r\n                          <h4 className=\"font-bold text-sm text-zinc-900 dark:text-white\">\r\n                            Medical Information Form *\r\n                          </h4>\r\n                          <p className=\"text-xs text-zinc-500 dark:text-zinc-400\">\r\n                            